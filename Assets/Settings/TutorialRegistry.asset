  _entries:
  - _id: 0
    _pages:
    - _image: {fileID: 2731430990181285971, guid: 6954dfd73abaed444adb03ff3667e566, type: 3}
      _text: "\u307E\u308B\u306D\u3053\u3078\u3088\u3046\u3053\u305D\uFF01\n\u3053\u306E\u30A2\u30D7\u30EA\u306F\u3001\u30DD\u30E2\u30C9\u30FC\u30ED\u30BF\u30A4\u30DE\u30FC\u3092\u4F7F\u3063\u305F\u308A\u3001\u7740\u305B\u66FF\u3048\u3084\u6A21\u69D8\u66FF\u3048\u3092\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\uFF01"
    - _image: {fileID: -3790979838214204543, guid: 8677984526bb26044bd667c929987d42, type: 3}
      _text: "\u30BF\u30A4\u30DE\u30FC\u4F7F\u3046\u3068\u6BDB\u7CF8\u304C\u3082\u3089\u3048\u308B\uFF01\n\u6BCE\u65E5\u3044\u3063\u3071\u3044\u96C6\u4E2D\u3057\u3066\n\u305F\u304F\u3055\u3093\u6BDB\u7CF8\u3092GET\u3057\u3088\u3046\uFF01"
    - _image: {fileID: 260413931910590178, guid: bb5c2a8942c3cfd4db7ce184cd10a47d, type: 3}
      _text: "\u30B7\u30E7\u30C3\u30D7\u3067\u6BDB\u7CF8\u3068\u5F15\u304D\u63DB\u3048\u306B\u5BB6\u5177\u3084\u670D\u3092\u624B\u306B\u5165\u308C\u3089\u308C\u308B\u3088\uFF01"
    - _image: {fileID: 1752693761155152944, guid: 5904738de18b0414d807ede95985102a, type: 3}
      _text: "\u30D5\u30C3\u30BF\u30FC\u306E\u30A2\u30A4\u30B3\u30F3\u304B\u3089\u8A66\u3057\u3066\u307F\u3088\u3046\uFF01"
  - _id: 1
    _pages:
    - _image: {fileID: 3446999281451876603, guid: 19bede96732b6d341ba12e0129935cb7, type: 3}
      _text: "\u30DD\u30E2\u30C9\u30FC\u30ED\u306F\u3001\u4F5C\u696D\u3068\u77ED\u3044\u4F11\u61A9\u3092\u7E70\u308A\u8FD4\u3057\u3066\u96C6\u4E2D\u529B\u3092\u7DAD\u6301\u3059\u308B\u30C6\u30AF\u30CB\u30C3\u30AF\u3060\u3088"
    - _image: {fileID: -2626666091713626358, guid: cf1787230b2f36e4f987ad4a104e9550, type: 3}
      _text: "\u3053\u306E\u30C0\u30A4\u30A2\u30ED\u30B0\u3067\u96C6\u4E2D\u6642\u9593\u30FB\u4F11\u61A9\u6642\u9593\u30FB\u30BB\u30C3\u30C8\u56DE\u6570\u3092\u6C7A\u3081\u3088\u3046\uFF01\nStart\u3092\u62BC\u3059\u3068\u3059\u3050\u30BF\u30A4\u30DE\u30FC\u304C\u59CB\u307E\u308B\u3088"
  - _id: 2
    _pages:
    - _image: {fileID: -6800628928115646414, guid: 60d03b72d178fb94b9942c4144d2bd96, type: 3}
      _text: "\u30BF\u30A4\u30DE\u30FC\u753B\u9762\u3067\u306F\u3001\u6B8B\u308A\u6642\u9593\u30FB\u6B8B\u308A\u30BB\u30C3\u30C8\u6570\u30FB\u5408\u8A08\u306E\u96C6\u4E2D\u6642\u9593\u304C\u898B\u308C\u3066\u3001\u4E00\u6642\u505C\u6B62\u3082\u3067\u304D\u308B\u3088"
    - _image: {fileID: -1494388622023411500, guid: 76f9979e788c489459d4676bd7d62367, type: 3}
      _text: "\u6642\u9593\u306B\u306A\u3063\u305F\u3089\u3001\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\u96C6\u4E2D\u3068\u4F11\u61A9\u3092\u5207\u308A\u66FF\u3048\u3088\u3046\uFF01\n0:00\u306B\u306A\u3063\u3066\u3082\u6642\u8A08\u306F\u6B62\u307E\u3089\u306A\u3044\u3088"
  - _id: 3
    _pages:
    - _image: {fileID: 8819565649861132475, guid: 76fa16306062a4b44a536ff8e0e039bf, type: 3}
      _text: "\u30B7\u30E7\u30C3\u30D7\u3067\u306F\u670D\u3084\u5BB6\u5177\u3092\u4EA4\u63DB\u3067\u304D\u308B\u3088\uFF01\n\u54C1\u63C3\u3048\u306F\u6642\u9593\u3067\u5165\u308C\u66FF\u308F\u308B\u3088"
    - _image: {fileID: -1344220005537297645, guid: b09842e165acb1640a97e188657b6a32, type: 3}
      _text: "\u6BCE\u65E5\u5E83\u544A\u3092\u898B\u308B\u3068\u6BDB\u7CF8\u304C\u3082\u3089\u3048\u308B\u3088"
  - _id: 4
    _pages:
    - _image: {fileID: -7462357097919856126, guid: 24245cce48b9e08418fb997f1c88a34f, type: 3}
      _text: "\u96C6\u4E2D\u3057\u305F\u6642\u9593\u3092\u78BA\u8A8D\u3067\u304D\u308B\u3088\n\u6BCE\u65E5\u4F7F\u3046\u3068\u9023\u7D9A\u65E5\u6570\u304C\u4F38\u3073\u308B\u3088\n\u76EE\u6307\u305B100\u65E5\u9023\u7D9A\uFF01"
